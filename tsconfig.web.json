{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "electron.vite.config.*",
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*.ts",
    "src/preload/*.d.ts",
    "src/types.ts"
  ],
  "compilerOptions": {
    "strictPropertyInitialization": false,
    "composite": false,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ],
      "@t": [
        "src/types.ts"
      ]
    }
  }
}